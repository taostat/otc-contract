{
    "name": "otc-contract-integration-tests",
    "version": "1.0.0",
    "description": "Integration tests for OTC contract",
    "type": "module",
    "scripts": {
        "test": "vitest",
        "test:ui": "vitest --ui",
        "test:run": "vitest run --no-file-parallelism --maxWorkers=1 --minWorkers=1",
        "test:localnet": "node scripts/run-localnet-tests.mjs",
        "test:localnet:combined": "node scripts/run-localnet-tests.mjs --restart all",
        "test:localnet:flaky": "node scripts/run-localnet-tests.mjs --restart file --repeat 3 src/tests/alpha-listing.test.ts src/tests/trading.test.ts src/tests/claim-dividends.test.ts src/tests/subnet-risk.test.ts src/lockup-listings/create-listing.test.ts src/lockup-listings/take-listing.test.ts src/lockup-listings/cancel-listing.test.ts src/lockup-listings/claim.test.ts",
        "test:watch": "vitest watch",
        "generate-api-types": "papi add devnet -w ws://localhost:9944",
        "generate-otc-contract-types": "papi ink add ../target/ink/otc_contract/otc_contract.contract",
        "postinstall": "papi && patch-package"
    },
    "dependencies": {
        "@polkadot-api/descriptors": "file:.papi/descriptors",
        "@polkadot-api/sdk-ink": "^0.4.0",
        "@polkadot/util": "^13.2.4",
        "polkadot-api": "^1.16.4"
    },
    "devDependencies": {
        "@polkadot-labs/hdkd": "^0.0.8",
        "@polkadot-labs/hdkd-helpers": "^0.0.8",
        "@types/node": "^22.5.5",
        "@vitest/ui": "^2.1.1",
        "patch-package": "^8.0.0",
        "tsx": "^4.19.1",
        "typescript": "^5.6.2",
        "vitest": "^2.1.1"
    }
}
